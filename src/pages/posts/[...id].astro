---
import { type GetStaticPaths, type GetStaticPathsItem } from "astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import Page from "@/layouts/page.astro";
import { formatPublicationDate } from "@/lib/posts";
import "@/styles/post.css";

interface Props {
	post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content } = await render(post);
const source = `https://github.com/vasilii-kovalev/blog/blob/main/${post.filePath}`;

export const getStaticPaths: GetStaticPaths = async () => {
	const postsCollection = await getCollection("posts");

	return postsCollection.map<GetStaticPathsItem>((entry) => {
		return {
			params: {
				id: entry.id,
			},
			props: {
				post: entry,
			},
		};
	});
};
---

<Page title={post.data.title} description={post.data.description}>
	<Header />
	<main>
		<article>
			<h1>{post.data.title}</h1>
			<time datetime={post.data.published} class="published-date">
				{formatPublicationDate(post.data.published)}
			</time>
			<Content />
		</article>
	</main>
	<Footer source={source} />
</Page>
