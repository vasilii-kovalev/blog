---
import { getCollection } from "astro:content";

import Header from "@/components/header.astro";
import { Search } from "@/components/search";
import Page from "@/layouts/page.astro";
import { postUrl } from "@/lib/posts";
import { getSearchIndex } from "@/lib/search-index";
import "@/styles/home.css";

const posts = await getCollection("posts");
const index = await getSearchIndex();
const indexUrl = `${import.meta.env.BASE_URL}search-index-${index.version}.json`;
---

<Page title="Home" description="Vasilii Kovalev's blog home page">
	<link slot="head" rel="preload" href={indexUrl} as="fetch" crossorigin="anonymous" />
	<Header home />
	<main>
		<h1>Welcome to Vasilii Kovalev's blog!</h1>
		<h2>Posts</h2>
		<Search
			indexUrl={indexUrl}
			posts={posts.map((post) => {
				return {
					url: postUrl(post.id, import.meta.env.BASE_URL),
					title: post.data.title,
					description: post.data.description,
				};
			})}
			client:load
		/>
		<noscript>Search requires JavaScript. All posts are listed above.</noscript>
	</main>
</Page>
