---
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import Search from "@/components/search.astro";
import Page from "@/layouts/page.astro";
import { getSearchIndex } from "@/lib/search-index";
import "@/styles/home.css";

const { version } = await getSearchIndex();
const indexUrl = `${import.meta.env.BASE_URL}search-index-${version}.json`;
---

<Page title="Home" description="Vasilii Kovalev's blog home page">
	<link slot="head" rel="preload" href={indexUrl} as="fetch" crossorigin="anonymous" />
	<Header home />
	<main>
		<h1>Welcome to Vasilii Kovalev's blog!</h1>
		<h2>Posts</h2>
		<Search indexUrl={indexUrl} />
		<noscript>Search requires JavaScript. All posts are listed above.</noscript>
	</main>
	<Footer />
</Page>
