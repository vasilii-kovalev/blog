---
interface Props {
	home?: boolean;
}
const { home = false } = Astro.props;
---

<header class="header">
	{home ? (
		<span class="header__logo header__logo--text">Vasilii Kovalev's blog</span>
	) : (
		<a href={import.meta.env.BASE_URL} class="header__logo">Vasilii Kovalev's blog</a>
	)}
	<ul class="social-links">
		<li class="social-links__link"><a href="https://github.com/vasilii-kovalev">GitHub</a></li>
		<li class="social-links__link"><a href="https://bsky.app/profile/vasilii-kovalev.bsky.social">Bluesky</a></li>
		<li class="social-links__link"><a href="https://twitter.com/vasilii_kovalev">Twitter</a></li>
	</ul>
</header>
