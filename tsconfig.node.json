{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "es2023",
		"module": "ESNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		// Required because the root config references this file. Declarations go under `node_modules/` so the source tree stays unchanged.
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./node_modules/.tmp/tsconfig.node",
		"strict": true,
		// Oxlint checks unused locals and allows names starting with "_"; TypeScript cannot configure that exception.
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["scripts", "oxlint.config.ts", "oxfmt.config.ts"]
}
