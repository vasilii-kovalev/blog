{
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.markdownlint": "explicit",
		"source.fixAll.stylelint": "explicit"
	},
	"markdownlint.config": {
		"MD024": {
			"siblings_only": true
		},
		"no-hard-tabs": {
			"code_blocks": false,
			"spaces_per_tab": 2
		}
	}
}
