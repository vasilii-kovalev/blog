{
	"name": "blog",
	"version": "1.0.0",
	"private": true,
	"description": "Vasilii Kovalev's blog",
	"keywords": [
		"astro",
		"blog",
		"css",
		"html",
		"markdown",
		"typescript"
	],
	"homepage": "https://github.com/vasilii-kovalev/blog#readme",
	"bugs": {
		"url": "https://github.com/vasilii-kovalev/blog/issues"
	},
	"license": "MIT",
	"author": "Vasilii Kovalev <vasilii.kovalev95@yandex.ru>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vasilii-kovalev/blog.git"
	},
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"prod:build": "astro build",
		"prod:preview": "astro preview",
		"prod:publish": "npm run prod:build && gh-pages -d dist --nojekyll",
		"astro:check": "astro check",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint:css:check": "stylelint \"**/*.css\" --ignore-path .gitignore",
		"lint:css:fix": "npm run lint:css:check -- --fix",
		"lint:markdown:check": "markdownlint \"**/*.md\" --ignore-path .gitignore",
		"lint:markdown:fix": "npm run lint:markdown:check -- --fix",
		"lint:spell:check": "cspell . --quiet --no-show-suggestions && cspell-check-unused-words",
		"lint:ts:check": "oxlint --ignore-path .gitignore",
		"lint:ts:fix": "npm run lint:ts:check -- --fix",
		"check-and-fix": "npm run astro:check && npm run lint:css:fix && npm run lint:markdown:fix && npm run lint:ts:fix && npm run lint:spell:check && npm run format:fix"
	},
	"dependencies": {
		"minisearch": "7.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/compiler-rs": "0.5.2",
		"@astrojs/markdown-satteri": "0.4.4",
		"@cspell/dict-ru_ru": "2.3.4",
		"astro": "7.4.0",
		"cspell": "10.4.0",
		"cspell-check-unused-words": "1.6.3",
		"gh-pages": "6.3.0",
		"markdownlint-cli": "0.49.1",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"satteri": "0.10.5",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-order": "8.1.2",
		"typescript": "6.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "^12.0.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^22.22.2 || ^24.15.0 || >=26.0.0",
			"onFail": "error"
		}
	}
}
